# GitHub Configuration
# Personal access token with 'repo' scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# CurseForge Configuration (optional)
# Project ID from your CurseForge project page
CF_PROJECT_ID=your_curseforge_project_id
# API token from: https://console.curseforge.com/
CF_API_TOKEN=your_curseforge_api_token

# CurseForge Game Version IDs (optional - auto-detected if omitted)
# Comma-separated numeric IDs, e.g., "9990,68441"
# CF_GAME_VERSION_IDS=9990,68441

# CurseForge Environment IDs (optional - auto-detected if omitted)
# Comma-separated IDs: Server=1, Client=2
# CF_ENVIRONMENT_IDS=1,2

# CurseForge Java Version ID (optional - auto-detected if omitted)
# CF_JAVA_VERSION_ID=12345

# CurseForge Release Type (optional - default: release)
# Options: release | beta | alpha
# CF_RELEASE_TYPE=release

# CurseForge Changelog File (optional - auto-detected from changelogs/{version}.md if omitted)
# CF_CHANGELOG_FILE=changelogs/8.0.4.md

# CurseForge Base URL (optional - default: https://minecraft.curseforge.com)
# CF_BASE_URL=https://minecraft.curseforge.com

# Modrinth Configuration (optional)
# Project ID from your Modrinth project page (find in project settings or URL)
MODRINTH_PROJECT_ID=your_modrinth_project_id
# API token from: https://modrinth.com/settings/pats
MODRINTH_TOKEN=your_modrinth_api_token

# Modrinth Game Versions (optional - auto-detected from gradle.properties if omitted)
# Comma-separated Minecraft versions, e.g., "1.21.1"
# MODRINTH_GAME_VERSIONS=1.21.1

# Modrinth Loaders (optional - auto-detects "neoforge" if omitted)
# Comma-separated mod loaders, e.g., "neoforge", "forge", "fabric"
# MODRINTH_LOADERS=neoforge

# Modrinth Release Type (optional - default: release)
# Options: release | beta | alpha
# MODRINTH_RELEASE_TYPE=release

# Modrinth Changelog File (optional - auto-detected from changelogs/{version}.md if omitted)
# MODRINTH_CHANGELOG_FILE=changelogs/8.0.4.md
